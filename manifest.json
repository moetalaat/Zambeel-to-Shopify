{
  "manifest_version": 3,
  "name": "Zambeel to Shopify",
  "version": "1.3.0",
  "description": "One-click import of Zambeel products (title, description, images, variants, prices) into your Shopify store.",
  "permissions": ["storage", "activeTab", "downloads", "clipboardWrite"],
  "host_permissions": [
    "https://*.myshopify.com/*",
    "https://products.myzambeel.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zambeel to Shopify"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
